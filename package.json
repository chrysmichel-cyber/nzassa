{
  "name": "nzassa",
  "version": "0.22.0",
  "private": true,
  "description": "Jeu 2D/3D éducatif : explorer un village, apprendre des langues africaines avec leçons, quiz, XP et badges. Contenus en brouillon, à valider.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --open",
    "validate": "node scripts/validate-data.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test tests/*.test.cjs",
    "e2e": "node tests/e2e.mjs && node tests/mobile.mjs",
    "test:all": "npm run lint && npm run validate && npm test && npm run e2e",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --outDir dist",
    "vendor:supabase": "node scripts/vendor-supabase.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.109.0",
    "playwright": "^1.45.0",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "8.22.2"
  }
}
